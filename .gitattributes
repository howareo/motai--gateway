* text=auto

*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.patch text eol=lf -whitespace
*.sh text eol=lf
*.ps1 text eol=crlf

# Preserve the exact bytes recorded by gateway build and evidence manifests.
/artifacts/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/contracts/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/gateway/build/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/gateway/core/overlay/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/gateway/core/source/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/gateway/candidate-lock.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/gateway/patches/series.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
