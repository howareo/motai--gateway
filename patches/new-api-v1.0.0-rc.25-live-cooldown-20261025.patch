+func recordChannelTransientOutcome(c *gin.Context, info *relaycommon.RelayInfo, channelID int, err *types.NewAPIError) {
+	if c == nil || c.Request == nil || c.Request.Context().Err() != nil {
+		return // A client cancellation is not an upstream health observation.
+	}
+	if err == nil {
+		if info.StreamStatus.HasErrors() || (info.IsStream && !info.StreamStatus.IsNormalEnd()) {
+			return // An interrupted stream must not reset actual upstream failures.
