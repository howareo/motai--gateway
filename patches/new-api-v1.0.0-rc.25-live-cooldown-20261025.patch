new file mode 100644
index 0000000..61e78a9
--- /dev/null
+++ b/model/channel_transient_failure.go
@@ -0,0 +1,89 @@
+package model
+
+import (
+	"sync"
+	"time"
+
+	"github.com/samber/hot"
+)
+
+const channelFailureWindow = 5 * time.Minute
+const channelCooldown = time.Minute
+
+type channelFailureRoute struct {
+	group, model string
+	channelID    int
+}
+
+type channelFailureState struct {
+	windowStart, cooldownUntil time.Time
+	count                      int
+}
+
+type channelFailureCircuit struct {
+	mu    sync.Mutex
+	cache *hot.HotCache[channelFailureRoute, channelFailureState]
+}
+
+func newChannelFailureCircuit() *channelFailureCircuit {
+	return &channelFailureCircuit{cache: hot.NewHotCache[channelFailureRoute, channelFailureState](hot.LRU, 10_000).
+		WithTTL(channelFailureWindow).Build()}
+}
+
+// shortcut: process-local cooldown resets on restart; share atomic state before running multiple core replicas.
+var channelFailures = newChannelFailureCircuit()
+
+func (c *channelFailureCircuit) record(route channelFailureRoute, status int, now time.Time) {
+	if route.group == "" || route.model == "" || route.channelID <= 0 || (status != 429 && (status < 500 || status > 599)) {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	state, found, _ := c.cache.Get(route)
+	if found && now.Before(state.cooldownUntil) {
+		return // In-flight failures must not extend a fixed cooldown.
+	}
+	if !found || !state.cooldownUntil.IsZero() || !now.Before(state.windowStart.Add(channelFailureWindow)) {
+		state = channelFailureState{windowStart: now}
+	}
+	state.count++
+	expires := state.windowStart.Add(channelFailureWindow)
+	if state.count >= 3 {
+		state.cooldownUntil = now.Add(channelCooldown)
+		expires = state.cooldownUntil
+	}
+	c.cache.SetWithTTL(route, state, expires.Sub(now))
+}
+
+func (c *channelFailureCircuit) reset(route channelFailureRoute) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.cache.Delete(route)
+}
+
+func (c *channelFailureCircuit) cooling(route channelFailureRoute, now time.Time) bool {
+	state, found, _ := c.cache.Get(route)
+	return found && now.Before(state.cooldownUntil)
+}
+
+func RecordChannelTransientFailure(group, modelName string, channelID, status int) {
+	channelFailures.record(channelFailureRoute{group, modelName, channelID}, status, time.Now())
+}
+
+func ResetChannelTransientFailures(group, modelName string, channelID int) {
+	channelFailures.reset(channelFailureRoute{group, modelName, channelID})
+}
+
+func filterChannelsOutsideCooldown(channels []int, group, modelName string) []int {
+	now := time.Now()
+	filtered := make([]int, 0, len(channels))
+	for _, id := range channels {
+		if !channelFailures.cooling(channelFailureRoute{group, modelName, id}, now) {
+			filtered = append(filtered, id)
+		}
+	}
+	if len(filtered) == 0 {
+		return channels // Cooling is a preference; never remove the only available route.
+	}
+	return filtered
+}
diff --git a/model/channel_transient_failure_test.go b/model/channel_transient_failure_test.go
new file mode 100644
index 0000000..682d4a1
--- /dev/null
+++ b/model/channel_transient_failure_test.go
@@ -0,0 +1,126 @@
+package model
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func TestChannelTransientFailureWindowAndCooldown(t *testing.T) {
+	c := newChannelFailureCircuit()
+	route := channelFailureRoute{"gemini", "gemini-test", 1}
+	now := time.Now()
+	for i := 0; i < 3; i++ {
+		c.record(route, 524, now.Add(time.Duration(i)*time.Second))
+		require.Equal(t, i == 2, c.cooling(route, now.Add(2*time.Second)))
+	}
+	for _, other := range []channelFailureRoute{{"other", route.model, 1}, {route.group, "other-model", 1}, {route.group, route.model, 2}} {
+		require.False(t, c.cooling(other, now.Add(2*time.Second)))
+	}
+	c.record(route, 524, now.Add(60*time.Second))
+	require.False(t, c.cooling(route, now.Add(62*time.Second)), "in-flight failures extended cooldown")
+	c.record(route, 524, now.Add(63*time.Second))
+	require.False(t, c.cooling(route, now.Add(63*time.Second)))
+	c.reset(route)
+	c.record(route, 429, now)
+	c.record(route, 500, now.Add(time.Second))
+	c.reset(route)
+	for i := 0; i < 2; i++ {
+		c.record(route, 503, now.Add(time.Duration(i+2)*time.Second))
+	}
+	require.False(t, c.cooling(route, now.Add(4*time.Second)), "success must reset the count")
+	c.record(route, 504, now.Add(4*time.Second))
+	require.True(t, c.cooling(route, now.Add(4*time.Second)))
+	c.reset(route)
+	require.False(t, c.cooling(route, now.Add(5*time.Second)), "success must also clear open cooldown")
+	for _, code := range []int{200, 400, 401, 403, 408} {
+		c.record(route, code, now)
+	}
+	c.record(route, 524, now)
+	c.record(route, 524, now.Add(time.Second))
+	c.record(route, 524, now.Add(channelFailureWindow))
+	require.False(t, c.cooling(route, now.Add(channelFailureWindow)), "window must be fixed, not sliding")
+}
+
+func TestChannelTransientFailureConcurrentCounting(t *testing.T) {
+	c := newChannelFailureCircuit()
+	route := channelFailureRoute{"default", "model", 1}
+	now := time.Now()
+	var wg sync.WaitGroup
+	for i := 0; i < 64; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); c.record(route, 524, now) }()
+	}
+	wg.Wait()
+	state, found, err := c.cache.Get(route)
+	require.NoError(t, err)
+	require.True(t, found)
+	require.Equal(t, 3, state.count)
+	require.Equal(t, now.Add(channelCooldown), state.cooldownUntil)
+}
+
+func TestChannelTransientFailureRoutingBothCaches(t *testing.T) {
+	originalDB, originalMemory, originalCircuit := DB, common.MemoryCacheEnabled, channelFailures
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(&Channel{}, &Ability{}))
+	DB = db
+	t.Cleanup(func() {
+		DB, common.MemoryCacheEnabled, channelFailures = originalDB, originalMemory, originalCircuit
+		if originalMemory && originalDB != nil {
+			InitChannelCache()
+		}
+		sqlDB, err := db.DB()
+		require.NoError(t, err)
+		require.NoError(t, sqlDB.Close())
+	})
+	for id := 1; id <= 2; id++ {
+		priority, weight := int64(30-id*10), uint(0)
+		require.NoError(t, db.Create(&Channel{Id: id, Name: fmt.Sprintf("synthetic-%d", id), Type: constant.ChannelTypeOpenAI,
+			Key: "synthetic-key", Models: "model-a,model-b", Group: "default,other", Status: common.ChannelStatusEnabled,
+			Priority: &priority, Weight: &weight}).Error)
+		for _, group := range []string{"default", "other"} {
+			for _, modelName := range []string{"model-a", "model-b"} {
+				require.NoError(t, db.Create(&Ability{Group: group, Model: modelName, ChannelId: id,
+					Enabled: true, Priority: &priority, Weight: weight}).Error)
+			}
+		}
+	}
+	for _, memory := range []bool{false, true} {
+		for _, path := range []string{"/v1/chat/completions", "/v1/responses", "/v1/messages", "/v1beta/models/model-a:generateContent"} {
+			t.Run(fmt.Sprintf("memory_%t/%s", memory, path), func(t *testing.T) {
+				channelFailures = newChannelFailureCircuit()
+				common.MemoryCacheEnabled = true
+				InitChannelCache()
+				common.MemoryCacheEnabled = memory
+				selectID := func(group, modelName string) int {
+					channel, err := GetRandomSatisfiedChannel(group, modelName, 0, path, 1)
+					require.NoError(t, err)
+					require.NotNil(t, channel)
+					return channel.Id
+				}
+				for i := 0; i < 2; i++ {
+					RecordChannelTransientFailure("default", "model-a", 1, 524)
+					require.Equal(t, 1, selectID("default", "model-a"))
+				}
+				RecordChannelTransientFailure("default", "model-a", 1, 524)
+				require.Equal(t, 2, selectID("default", "model-a"), "cooldown must override priority and affinity")
+				require.Equal(t, 1, selectID("other", "model-a"))
+				require.Equal(t, 1, selectID("default", "model-b"))
+				for i := 0; i < 3; i++ {
+					RecordChannelTransientFailure("default", "model-a", 2, 503)
+				}
+				require.Equal(t, 1, selectID("default", "model-a"), "all cooling must retain the original route")
+				ResetChannelTransientFailures("default", "model-a", 1)
+				require.Equal(t, 1, selectID("default", "model-a"))
+			})
+		}
+	}
+}
