+)
+
+func TestTransientFailureNeverReplaysTimeoutOrWrittenResponse(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, status := range []int{429, 500, 502, 503, 504, 524} {
+		ctx, _ := gin.CreateTestContext(httptest.NewRecorder())
+		err := types.NewErrorWithStatusCode(errors.New("synthetic timeout"), types.ErrorCodeBadResponseStatusCode, status)
+		require.False(t, shouldRetry(ctx, err, 2))
+	}
+	ctx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ctx.String(200, "synthetic partial output")
+	err := types.NewErrorWithStatusCode(errors.New("synthetic error after output"), types.ErrorCodeBadResponseStatusCode, 503)
+	require.False(t, shouldRetry(ctx, err, 2))
+}
+
+func TestTransientFailureClientCancellationIsNotUpstreamFailure(t *testing.T) {
+	originalDB, originalMemory := model.DB, common.MemoryCacheEnabled
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(&model.Channel{}, &model.Ability{}))
+	model.DB, common.MemoryCacheEnabled = db, true
+	const group, name = "cancel-test", "synthetic-cancel-model"
+	for id := 1; id <= 2; id++ {
+		priority := int64(30 - id*10)
+		require.NoError(t, db.Create(&model.Channel{Id: id, Type: constant.ChannelTypeOpenAI, Name: "synthetic",
+			Key: "synthetic-key", Status: common.ChannelStatusEnabled, Group: group, Models: name, Priority: &priority}).Error)
+		require.NoError(t, db.Create(&model.Ability{ChannelId: id, Group: group, Model: name, Enabled: true, Priority: &priority}).Error)
+	}
+	model.InitChannelCache()
+	t.Cleanup(func() {
+		model.ResetChannelTransientFailures(group, name, 1)
+		model.DB, common.MemoryCacheEnabled = originalDB, originalMemory
+		if originalMemory && originalDB != nil {
+			model.InitChannelCache()
+		}
+		sqlDB, err := db.DB()
+		require.NoError(t, err)
+		require.NoError(t, sqlDB.Close())
+	})
+	info := &relaycommon.RelayInfo{UsingGroup: group, OriginModelName: name}
+	errUpstream := types.NewErrorWithStatusCode(errors.New("synthetic timeout"), types.ErrorCodeDoRequestFailed, 500)
+	active, _ := gin.CreateTestContext(httptest.NewRecorder())
+	active.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", nil)
+	for i := 0; i < 2; i++ {
+		recordChannelTransientOutcome(active, info, 1, errUpstream)
+	}
+	cancelled, cancel := context.WithCancel(context.Background())
+	cancel()
+	expired, finish := context.WithDeadline(context.Background(), time.Now().Add(-time.Second))
+	defer finish()
+	for _, ctx := range []context.Context{cancelled, expired} {
+		request, _ := gin.CreateTestContext(httptest.NewRecorder())
+		request.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", nil).WithContext(ctx)
+		recordChannelTransientOutcome(request, info, 1, errUpstream)
+		recordChannelTransientOutcome(request, info, 1, nil)
+		channel, err := model.GetRandomSatisfiedChannel(group, name, 0, "/v1/chat/completions", 0)
+		require.NoError(t, err)
+		require.Equal(t, 1, channel.Id, "cancelled transport opened the upstream circuit")
+	}
+	info.StreamStatus = relaycommon.NewStreamStatus()
+	info.StreamStatus.RecordError("synthetic interrupted stream")
+	recordChannelTransientOutcome(active, info, 1, nil)
+	recordChannelTransientOutcome(active, info, 1, errUpstream)
+	channel, err := model.GetRandomSatisfiedChannel(group, name, 0, "/v1/chat/completions", 0)
+	require.NoError(t, err)
+	require.Equal(t, 2, channel.Id, "cancelled nil error incorrectly reset actual upstream failures")
+}
+
+func TestTransientFailureExplicitChannelBypassesAutomaticSelection(t *testing.T) {
+	ctx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ctx.Set("specific_channel_id", "123")
+	ctx.Set("channel_id", 123)
+	ctx.Set("channel_type", 1)
+	info := &relaycommon.RelayInfo{ChannelMeta: &relaycommon.ChannelMeta{ChannelId: 123}}
+	channel, err := getChannel(ctx, info, &service.RetryParam{Ctx: ctx, TokenGroup: "default", ModelName: "synthetic-model"})
+	require.Nil(t, err)
+	require.Equal(t, 123, channel.Id)
+}
