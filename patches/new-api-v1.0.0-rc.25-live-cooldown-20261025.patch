+func TestGetRandomSatisfiedChannelAffinityRespectsCandidates(t *testing.T) {
+	originalMemoryCacheEnabled := common.MemoryCacheEnabled
+	t.Cleanup(func() {
+		require.NoError(t, DB.Exec("DELETE FROM abilities").Error)
+		require.NoError(t, DB.Exec("DELETE FROM channels").Error)
+		common.MemoryCacheEnabled = true
+		InitChannelCache()
+		common.MemoryCacheEnabled = originalMemoryCacheEnabled
+	})
+	cases := []struct {
+		name            string
+		primaryPriority int64
+		primaryModel    string
+		primaryGroup    string
+		preferredStatus int
+		primaryStatus   int
+		preferredType   int
+		retry           int
+		preference      int
+		want            int
+	}{
+		{name: "restored_primary_overrides_affinity", primaryPriority: 7, preference: 1, want: 2},
+		{name: "same_priority_keeps_affinity_even_with_zero_weight", primaryPriority: 6, preference: 1, want: 1},
+		{name: "higher_priority_unsupported_model", primaryPriority: 7, primaryModel: "other-model", preference: 1, want: 1},
+		{name: "higher_priority_other_group", primaryPriority: 7, primaryGroup: "vip", preference: 1, want: 1},
+		{name: "disabled_preference", primaryPriority: 7, preferredStatus: common.ChannelStatusManuallyDisabled, preference: 1, want: 2},
+		{name: "disabled_primary", primaryPriority: 7, primaryStatus: common.ChannelStatusManuallyDisabled, preference: 1, want: 1},
