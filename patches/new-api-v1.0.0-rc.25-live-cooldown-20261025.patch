+)
+
+func TestDistributeAffinityFollowsCurrentPriorityOnNextRequest(t *testing.T) {
+	originalDB, originalMemory, originalRedis := model.DB, common.MemoryCacheEnabled, common.RedisEnabled
+	affinity := operation_setting.GetChannelAffinitySetting()
+	originalAffinity := *affinity
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(&model.Channel{}, &model.Ability{}))
+	model.DB, common.MemoryCacheEnabled, common.RedisEnabled = db, true, false
+	affinity.Enabled = true
+	affinity.Rules = []operation_setting.ChannelAffinityRule{{Name: "priority-regression", SkipRetryOnFailure: true, ModelRegex: []string{".*"}, KeySources: []operation_setting.ChannelAffinityKeySource{{Type: "request_header", Key: "X-Affinity-Key"}}, IncludeRuleName: true, IncludeModelName: true, IncludeUsingGroup: true}}
+	t.Cleanup(func() {
+		*affinity = originalAffinity
+		model.DB, common.MemoryCacheEnabled, common.RedisEnabled = originalDB, originalMemory, originalRedis
+		if originalMemory && originalDB != nil && originalDB.Migrator().HasTable(&model.Channel{}) && originalDB.Migrator().HasTable(&model.Ability{}) {
+			model.InitChannelCache()
+		}
+		sqlDB, err := db.DB()
+		require.NoError(t, err)
+		require.NoError(t, sqlDB.Close())
+	})
+	for id := 1; id <= 2; id++ {
+		priority := int64(6)
+		if id == 2 {
+			priority = 7
+		}
+		require.NoError(t, db.Create(&model.Channel{Id: id, Name: fmt.Sprintf("channel-%d", id), Type: constant.ChannelTypeOpenAI, Key: "test-key", Models: "grok4.7", Group: "default", Status: common.ChannelStatusEnabled, Priority: &priority}).Error)
+		require.NoError(t, db.Create(&model.Ability{ChannelId: id, Model: "grok4.7", Group: "default", Enabled: true, Priority: &priority}).Error)
+	}
+	model.InitChannelCache()
+	gin.SetMode(gin.TestMode)
+	for _, path := range []string{"/v1/chat/completions", "/v1/responses", "/v1/messages", "/v1beta/models/grok4.7:generateContent"} {
+		t.Run(path, func(t *testing.T) {
+			newContext := func() *gin.Context {
+				ctx, _ := gin.CreateTestContext(httptest.NewRecorder())
+				ctx.Request = httptest.NewRequest(http.MethodPost, path, strings.NewReader(`{"model":"grok4.7"}`))
+				ctx.Request.Header.Set("Content-Type", "application/json")
+				ctx.Request.Header.Set("X-Affinity-Key", t.Name())
+				common.SetContextKey(ctx, constant.ContextKeyUsingGroup, "default")
+				return ctx
+			}
+			seed := newContext()
+			service.GetPreferredChannelByAffinity(seed, "grok4.7", "default")
+			service.RecordChannelAffinity(seed, 1)
+			defer service.ClearCurrentChannelAffinityCache(seed)
+
+			ctx := newContext()
+			Distribute()(ctx)
+			require.False(t, ctx.IsAborted())
+			assert.Equal(t, 2, ctx.GetInt("channel_id"))
+			assert.True(t, service.ShouldSkipRetryAfterChannelAffinityFailure(ctx))
+
+			// An old in-flight success may write the demoted channel again.
+			service.RecordChannelAffinity(seed, 1)
+			next := newContext()
+			Distribute()(next)
+			require.False(t, next.IsAborted())
+			assert.Equal(t, 2, next.GetInt("channel_id"))
+			assert.True(t, service.ShouldSkipRetryAfterChannelAffinityFailure(next))
+
+			explicit := newContext()
+			common.SetContextKey(explicit, constant.ContextKeyTokenSpecificChannelId, "1")
+			Distribute()(explicit)
+			require.False(t, explicit.IsAborted())
+			assert.Equal(t, 1, explicit.GetInt("channel_id"))
+		})
+	}
+}
