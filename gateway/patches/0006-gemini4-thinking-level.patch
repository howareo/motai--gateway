@@ -0,0 +1,71 @@
+package relayconvert
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/QuantumNous/new-api/relaykit/relayconvert/convmeta"
+	"github.com/QuantumNous/new-api/relaykit/types"
+)
+
+func TestGemini4ThinkingLevelByModel(t *testing.T) {
+	cases := []struct {
+		name    string
+		model   string
+		request any
+		body    string
+		want    string
+	}{
+		{"hydrogen chat xhigh", "gemini-4-hydrogen", &dto.GeneralOpenAIRequest{}, `{"reasoning_effort":"xhigh"}`, "xhigh"},
+		{"argon chat xhigh", "gemini-4-argon", &dto.GeneralOpenAIRequest{}, `{"reasoning_effort":"xhigh"}`, "high"},
+		{"hydrogen responses max", "gemini-4-hydrogen", &dto.OpenAIResponsesRequest{}, `{"model":"gemini-4-hydrogen","input":"hi","reasoning":{"effort":"max"}}`, "max"},
+		{"argon native max", "gemini-4-argon", &dto.GeminiChatRequest{}, `{"generationConfig":{"thinkingConfig":{"thinkingLevel":"max"}}}`, "max"},
+		{"hydrogen native minimal", "gemini-4-hydrogen", &dto.GeminiChatRequest{}, `{"generationConfig":{"thinking_config":{"thinking_level":"MINIMAL"}}}`, "low"},
+		{"argon chat extra-body xhigh", "gemini-4-argon", &dto.GeneralOpenAIRequest{}, `{"extra_body":{"google":{"thinking_config":{"thinking_level":"xhigh"}}}}`, "high"},
+		{"hydrogen messages xhigh", "gemini-4-hydrogen", &dto.ClaudeRequest{}, `{"model":"gemini-4-hydrogen","messages":[{"role":"user","content":"hi"}],"thinking":{"type":"adaptive"},"output_config":{"effort":"xhigh"}}`, "xhigh"},
+		{"argon suffix max", "gemini-4-argon-max", &dto.GeneralOpenAIRequest{}, `{"reasoning_effort":"low"}`, "max"},
+		{"hydrogen default omitted", "gemini-4-hydrogen", &dto.GeneralOpenAIRequest{}, `{}`, ""},
+		{"gemini 3 native unchanged", "gemini-3.1-pro", &dto.GeminiChatRequest{}, `{"generationConfig":{"thinkingConfig":{"thinkingLevel":"minimal"}}}`, "minimal"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := json.Unmarshal([]byte(tc.body), tc.request); err != nil {
+				t.Fatal(err)
+			}
+			info := &convmeta.Values{ChannelMetaAttached: true, UpstreamModelName: tc.model}
+			info.ConvOptions().Gemini.ThinkingAdapterEnabled = tc.name == "argon suffix max"
+			native, ok := tc.request.(*dto.GeminiChatRequest)
+			if ok {
+				ApplyGeminiThinkingConfig(native, info)
+			} else {
+				result, err := ConvertRequest(context.Background(), info, types.RelayFormatGemini, tc.request)
+				if err != nil {
+					t.Fatal(err)
+				}
+				native, ok = result.Value.(*dto.GeminiChatRequest)
+				if !ok {
+					t.Fatalf("unexpected converted type %T", result.Value)
+				}
+			}
+			config := native.GenerationConfig.ThinkingConfig
+			if tc.want == "" {
+				if config != nil || info.GetReasoningEffort() != "" {
+					t.Fatalf("default request injected config %+v or effort %q", config, info.GetReasoningEffort())
+				}
+				return
+			}
+			if config == nil || config.ThinkingLevel != tc.want || config.ThinkingBudget != nil {
+				t.Fatalf("got config %+v, want level %q without budget", config, tc.want)
+			}
+			effort := tc.want
+			if tc.model == "gemini-3.1-pro" {
+				effort = ""
+			}
+			if got := info.GetReasoningEffort(); got != effort {
+				t.Fatalf("logged effort %q, want %q", got, effort)
+			}
+		})
+	}
+}
