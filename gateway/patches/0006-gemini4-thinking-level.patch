@@ -0,0 +1,25 @@
+package reasoning
+
+import "strings"
+
+func IsGemini4ThinkingLevelModel(model string) bool {
+	model = strings.ToLower(model)
+	return strings.HasPrefix(model, "gemini-4-argon") || strings.HasPrefix(model, "gemini-4-hydrogen")
+}
+
+// Gemini4ThinkingLevel applies the model-specific rules from upstream New API #8367.
+func Gemini4ThinkingLevel(model, effort string) string {
+	switch effort := strings.ToLower(strings.TrimSpace(effort)); effort {
+	case "minimal":
+		return "low"
+	case "xhigh":
+		if strings.HasPrefix(strings.ToLower(model), "gemini-4-argon") {
+			return "high"
+		}
+		return effort
+	case "low", "medium", "high", "max":
+		return effort
+	default:
+		return ""
+	}
+}
