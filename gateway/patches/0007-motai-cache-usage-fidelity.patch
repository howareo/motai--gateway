+func TestClaudeCacheOnlyDeltaPreservesReportedUsage(t *testing.T) {
+	info := &ClaudeResponseInfo{}
+	start := &dto.ClaudeResponse{Type: "message_start", Message: &dto.ClaudeMediaMessage{Usage: &dto.ClaudeUsage{
+		InputTokens: 100, OutputTokens: 4, CacheCreationInputTokens: 50,
+		CacheCreation: &dto.ClaudeCacheCreationUsage{Ephemeral5mInputTokens: 10},
+	}}}
+	require.True(t, FormatClaudeResponseInfo(start, nil, info))
+	delta := &dto.ClaudeResponse{Type: "message_delta", Usage: &dto.ClaudeUsage{
+		CacheCreation: &dto.ClaudeCacheCreationUsage{Ephemeral1hInputTokens: 20},
+	}}
+	require.True(t, FormatClaudeResponseInfo(delta, nil, info))
+	observed := info.Usage.BillingUsage.ClaudeUsage
+	require.EqualValues(t, 100, observed.InputTokens)
+	require.EqualValues(t, 4, observed.OutputTokens)
+	require.EqualValues(t, 50, observed.CacheCreationInputTokens)
+	require.EqualValues(t, 10, observed.GetCacheCreation5mTokens())
+	require.EqualValues(t, 20, observed.GetCacheCreation1hTokens())
+
+	wire := buildOpenAIStyleUsageFromClaudeUsage(info.Usage)
+	require.EqualValues(t, 150, wire.PromptTokens)
+	require.EqualValues(t, 50, wire.PromptTokensDetails.CacheWriteTokens)
+	require.EqualValues(t, 10, wire.ClaudeCacheCreation5mTokens)
+	require.EqualValues(t, 20, wire.ClaudeCacheCreation1hTokens)
+
+	patched := buildMessageDeltaPatchUsage(delta, info)
+	require.EqualValues(t, 10, patched.GetCacheCreation5mTokens())
+	require.EqualValues(t, 20, patched.GetCacheCreation1hTokens())
+	require.Zero(t, delta.Usage.GetCacheCreation5mTokens())
+}
