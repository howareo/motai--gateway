+// Motai: a client disconnect closes the upstream body on purpose, so neither the
+// resulting read error nor the stream summary may be logged at [ERR].
+func TestStreamScannerHandler_ClientGoneIsNotLoggedAsError(t *testing.T) {
+	var logs syncBuffer
+	common.LogWriterMu.Lock()
+	previousOut, previousErr := gin.DefaultWriter, gin.DefaultErrorWriter
+	gin.DefaultWriter, gin.DefaultErrorWriter = &logs, &logs
+	common.LogWriterMu.Unlock()
+	t.Cleanup(func() {
+		common.LogWriterMu.Lock()
+		gin.DefaultWriter, gin.DefaultErrorWriter = previousOut, previousErr
+		common.LogWriterMu.Unlock()
+	})
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	pr, pw := io.Pipe()
+	t.Cleanup(func() {
+		_ = pr.Close()
+		_ = pw.Close()
+	})
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", nil).WithContext(ctx)
+	c.Set(common.RequestIdKey, "motai-client-gone-log")
+	info := &relaycommon.RelayInfo{DisablePing: true, ChannelMeta: &relaycommon.ChannelMeta{}}
+
+	firstHandled := make(chan struct{})
+	done := make(chan struct{})
+	go func() {
+		StreamScannerHandler(c, &http.Response{Body: pr}, info, func(data string, sr *StreamResult) {
+			if data == "first" {
+				close(firstHandled)
+			}
+		})
+		close(done)
+	}()
+	_, err := fmt.Fprint(pw, "data: first\n")
+	require.NoError(t, err)
+	select {
+	case <-firstHandled:
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for first chunk")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("handler did not return after client disconnect")
+	}
+
+	var own []string
+	for _, line := range strings.Split(logs.String(), "\n") {
+		if strings.Contains(line, "motai-client-gone-log") {
+			own = append(own, line)
+		}
+	}
+	joined := strings.Join(own, "\n")
+	assert.NotContains(t, joined, "[ERR]")
+	assert.Contains(t, joined, "[WARN]")
+	assert.Contains(t, joined, "reason=client_gone")
+}
+
+type syncBuffer struct {
+	mu  sync.Mutex
+	buf bytes.Buffer
+}
+
+func (b *syncBuffer) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.Write(p)
+}
+
+func (b *syncBuffer) String() string {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.String()
+}
