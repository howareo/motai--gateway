 			}
 		}
@@ -304,6 +310,9 @@ func StreamScannerHandler(c *gin.Context, resp *http.Response, info *relaycommon
 	cleanup()
 	if info.StreamStatus.IsNormalEnd() && !info.StreamStatus.HasErrors() {
 		logger.LogInfo(c, fmt.Sprintf("stream ended: %s", info.StreamStatus.Summary()))
+	} else if info.StreamStatus.EndReason == relaycommon.StreamEndReasonClientGone && !info.StreamStatus.HasErrors() {
+		// Motai: a client disconnect is the caller's choice; keep [ERR] for real faults.
+		logger.LogWarn(c, fmt.Sprintf("stream ended: %s, received=%d", info.StreamStatus.Summary(), info.ReceivedResponseCount))
 	} else {
 		logger.LogError(c, fmt.Sprintf("stream ended: %s, received=%d", info.StreamStatus.Summary(), info.ReceivedResponseCount))
 	}
