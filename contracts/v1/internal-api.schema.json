        "next_seq": {
          "$ref": "common.schema.json#/definitions/decimal"
        },
        "latest_seq": {
          "$ref": "common.schema.json#/definitions/decimal"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "required": [
        "format_version",
        "events",
        "next_seq",
        "latest_seq",
        "has_more"
      ],
      "additionalProperties": false
    },
    "attempts_query": {
      "type": "object",
      "properties": {
        "reverse": { "type": "boolean" },
        "cooldown_only": { "type": "boolean" },
        "stream": {
          "type": ["boolean", "null"]
        },
        "from": {
          "$ref": "common.schema.json#/definitions/utc"
        },
        "to": {
          "$ref": "common.schema.json#/definitions/utc"
        },
        "channel_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "pool_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/model_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/attempt_outcome"
          },
          "minItems": 0,
          "maxItems": 17,
          "uniqueItems": true
        },
        "snapshot_seq": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "from",
        "to",
        "channel_id",
        "pool_id",
        "model_id",
        "kind",
        "outcomes",
        "snapshot_seq",
        "cursor",
        "limit"
      ],
      "additionalProperties": false
    },
    "attempts_page": {
      "type": "object",
      "properties": {
        "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "format_version": {
          "const": 1
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "records.schema.json#/definitions/attempt"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "snapshot_seq": {
          "$ref": "common.schema.json#/definitions/decimal"
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "required": [
        "format_version",
        "attempts",
        "snapshot_seq",
        "next_cursor",
        "has_more"
      ],
      "additionalProperties": false
    },
    "stats_query": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "common.schema.json#/definitions/utc"
        },
        "to": {
          "$ref": "common.schema.json#/definitions/utc"
        },
        "channel_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "pool_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/model_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/attempt_outcome"
          },
          "minItems": 0,
          "maxItems": 17,
          "uniqueItems": true
        },
        "snapshot_seq": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from",
        "to",
        "channel_id",
        "pool_id",
        "model_id",
        "kind",
        "outcomes",
        "snapshot_seq"
      ],
      "additionalProperties": false
    },
    "token_totals": {
      "type": "object",
      "properties": {
        "total_input": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "input_uncached": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "cache_read": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "cache_write_5m": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "cache_write_1h": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "cache_write_unknown": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "output_total": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "reasoning": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        }
      },
      "required": [
        "total_input",
        "input_uncached",
        "cache_read",
        "cache_write_5m",
        "cache_write_1h",
        "cache_write_unknown",
        "output_total",
        "reasoning"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "attempts": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "usage_known": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "usage_partial": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "usage_unknown": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "estimated": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        }
      },
      "required": [
        "attempts",
        "usage_known",
        "usage_partial",
        "usage_unknown",
        "estimated"
      ],
      "additionalProperties": false
    },
    "stats_counts": {
      "type": "object",
      "properties": {
        "requests": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "attempts": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "requests_succeeded": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "probes": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "probes_succeeded": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        }
      },
      "required": [
        "requests",
        "attempts",
        "requests_succeeded",
        "probes",
        "probes_succeeded"
      ],
      "additionalProperties": false
    },
    "stats_bucket": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "common.schema.json#/definitions/utc"
        },
        "to": {
          "$ref": "common.schema.json#/definitions/utc"
        },
        "counts": {
          "$ref": "internal-api.schema.json#/definitions/stats_counts"
        },
        "tokens": {
          "$ref": "internal-api.schema.json#/definitions/token_totals"
        },
        "coverage": {
          "$ref": "internal-api.schema.json#/definitions/coverage"
        }
      },
      "required": [
        "from",
        "to",
        "counts",
        "tokens",
        "coverage"
      ],
      "additionalProperties": false
    },
    "stats_response": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "from": {
          "$ref": "common.schema.json#/definitions/utc"
        },
        "to": {
          "$ref": "common.schema.json#/definitions/utc"
        },
        "snapshot_seq": {
          "$ref": "common.schema.json#/definitions/decimal"
        },
        "counts": {
          "$ref": "internal-api.schema.json#/definitions/stats_counts"
        },
        "tokens": {
          "$ref": "internal-api.schema.json#/definitions/token_totals"
        },
        "coverage": {
          "$ref": "internal-api.schema.json#/definitions/coverage"
        },
        "buckets": {
          "type": "array",
          "items": {
            "$ref": "internal-api.schema.json#/definitions/stats_bucket"
          },
          "minItems": 0,
          "maxItems": 366
        }
      },
      "required": [
        "format_version",
        "from",
        "to",
        "snapshot_seq",
        "counts",
        "tokens",
        "coverage",
        "buckets"
      ],
      "additionalProperties": false
    },
    "models_request": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        }
      },
      "required": [
        "format_version"
      ],
      "additionalProperties": false
    },
    "model_candidate": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/definitions/model_id"
