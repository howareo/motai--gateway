      "required": [
        "format_version",
        "models",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "preview_request": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "adapter": {
          "enum": ["openai", "anthropic", "deepseek", "xai", "gemini", "moonshot"]
        },
        "base_url": {
          "$ref": "common.schema.json#/definitions/http_url"
        },
        "credential": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "channel_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/protocol"
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "format_version",
        "base_url",
        "credential",
        "channel_id",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "probe_request": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "source": {
          "enum": [
            "manual",
            "scheduled"
          ]
        },
        "pool_id": { "$ref": "common.schema.json#/definitions/id" },
        "channel_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "model_id": {
          "$ref": "common.schema.json#/definitions/model_id"
        },
        "protocol": {
          "$ref": "common.schema.json#/definitions/protocol"
        },
        "client_run_id": {
          "$ref": "common.schema.json#/definitions/uuid"
        }
      },
      "required": [
        "format_version",
        "source",
        "channel_id",
        "model_id",
        "protocol",
        "client_run_id"
      ],
      "additionalProperties": false
    },
    "probe_response": {
      "type": "object",
