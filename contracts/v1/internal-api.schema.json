{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://motai.local/contracts/v1/internal-api.schema.json",
  "definitions": {
    "status": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ready": {
          "type": "boolean"
        },
        "desired_gen": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "committed_gen": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "serving_gen": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "lkg_gen": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "degraded_reasons": {
          "type": "array",
          "items": {
            "enum": [
              "not_activated",
              "configuration_invalid",
              "storage_unavailable",
              "completion_queue_full",
              "completion_write_failed",
              "completion_lag",
              "completion_wait_exceeded",
              "runtime_lease_lost",
              "in_flight_limit",
              "draining"
            ]
          },
          "minItems": 0,
          "maxItems": 10,
          "uniqueItems": true
        },
        "in_flight": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "completion_pending": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "probe_completion_quarantined": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "completion_capacity": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "latest_seq": {
          "$ref": "common.schema.json#/definitions/decimal"
        },
        "referenced_gens": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/decimal"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        }
      },
      "required": [
        "format_version",
        "build_id",
        "ready",
        "desired_gen",
        "committed_gen",
        "serving_gen",
        "lkg_gen",
        "degraded_reasons",
        "in_flight",
        "completion_pending",
        "completion_capacity",
        "latest_seq",
        "referenced_gens"
      ],
      "additionalProperties": false
    },
    "activate_request": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "gen": {
          "$ref": "common.schema.json#/definitions/decimal"
        },
        "manifest_sha256": {
          "$ref": "common.schema.json#/definitions/sha256"
        },
        "base_committed_gen": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format_version",
        "gen",
        "manifest_sha256",
        "base_committed_gen"
      ],
      "additionalProperties": false
    },
    "activate_response": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "gen": {
          "$ref": "common.schema.json#/definitions/decimal"
        },
        "manifest_sha256": {
          "$ref": "common.schema.json#/definitions/sha256"
        },
        "committed_gen": {
          "$ref": "common.schema.json#/definitions/decimal"
        },
        "serving_gen": {
          "$ref": "common.schema.json#/definitions/decimal"
        }
      },
      "required": [
        "format_version",
        "gen",
        "manifest_sha256",
        "committed_gen",
        "serving_gen"
      ],
      "additionalProperties": false
    },
    "events_query": {
      "type": "object",
      "properties": {
        "after_seq": {
          "$ref": "common.schema.json#/definitions/decimal"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      },
      "required": [
        "after_seq",
        "limit"
      ],
      "additionalProperties": false
