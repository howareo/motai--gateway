        "format_version": { "const": 1 },
        "pool_id": { "$ref": "common.schema.json#/definitions/id" },
        "operation_id": { "$ref": "common.schema.json#/definitions/uuid" },
        "channel_id": { "$ref": "common.schema.json#/definitions/id" },
        "credential_version": { "$ref": "common.schema.json#/definitions/decimal" },
        "state": { "const": "available" },
        "state_version": { "$ref": "common.schema.json#/definitions/decimal" },
        "changed": { "type": "boolean" }
      },
      "required": ["format_version", "operation_id", "channel_id", "credential_version", "state", "state_version", "changed"],
      "additionalProperties": false
    },
    "operation_request": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "common.schema.json#/definitions/uuid"
        }
      },
      "required": [
        "format_version",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "affinity_reset_response": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "pool_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "pool_epoch": {
          "$ref": "common.schema.json#/definitions/decimal"
        }
      },
      "required": [
        "format_version",
        "operation_id",
        "pool_id",
        "pool_epoch"
      ],
      "additionalProperties": false
    },
    "drain_response": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "accepting": {
          "type": "boolean"
        },
        "in_flight": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        },
        "completion_pending": {
          "$ref": "common.schema.json#/definitions/safe_uint"
        }
      },
      "required": [
        "format_version",
        "operation_id",
        "accepting",
        "in_flight",
        "completion_pending"
      ],
      "additionalProperties": false
    },
    "billing_probe_response": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "channel_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "unsupported"
          ]
        },
        "multiplier": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "management_api",
            "unsupported",
            "unavailable"
          ]
        },
        "observed_at": {
          "$ref": "common.schema.json#/definitions/utc"
        },
        "error_class": {
          "enum": [
            "bad_content_type",
            "channel_proxy_unsupported",
            "channel_type_unsupported",
            "dns_error",
            "endpoint_unsupported",
            "group_unresolved",
            "http_4xx",
            "http_5xx",
            "invalid_target",
            "key_unavailable",
            "network_error",
            "probe_failed",
            "probe_rate_limited",
            "redirect_blocked",
            "response_read_error",
            "response_too_large",
            "schema_invalid",
            "target_blocked",
            "timeout",
            "tls_error",
            "unauthorized",
            "value_out_of_band"
          ]
        },
        "daily_costs": {
          "type": "array",
          "maxItems": 90,
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "actualCost": { "type": "number", "minimum": 0 },
              "standardCost": { "type": "number", "minimum": 0 },
              "requests": { "type": "integer", "minimum": 0 }
            },
            "required": ["date", "actualCost", "standardCost", "requests"],
            "additionalProperties": false
          }
        },
        "upstream_group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        }
      },
      "required": [
        "format_version",
        "channel_id",
        "state",
        "multiplier",
        "source",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "wallet_probe_response": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "channel_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "unsupported"
          ]
        },
        "balance": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "account_wallet",
            "unsupported",
            "unavailable"
          ]
        },
        "observed_at": {
          "$ref": "common.schema.json#/definitions/utc"
        }
      },
      "required": [
        "format_version",
        "channel_id",
        "state",
        "balance",
        "currency",
        "source",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "error_response": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid_contract",
                "invalid_config",
                "stale_base_generation",
                "generation_conflict",
                "generation_not_found",
                "activation_failed",
                "gateway_not_ready",
                "gateway_log_unavailable",
                "gateway_draining",
                "channel_not_found",
                "channel_state_conflict",
                "pool_not_found",
                "permission_denied",
                "upstream_unavailable",
                "probe_unavailable",
                "cursor_invalid",
                "snapshot_invalid",
                "operation_conflict",
                "internal_error"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "properties": {
                "gen": {
                  "anyOf": [
                    {
                      "$ref": "common.schema.json#/definitions/decimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "retry_after_seconds": {
                  "$ref": "common.schema.json#/definitions/nullable_uint"
                }
              },
              "required": [
                "gen",
                "retry_after_seconds"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "format_version",
        "error"
      ],
      "additionalProperties": false
    }
  }
}
