        "client_run_id": {
          "$ref": "common.schema.json#/definitions/uuid"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "accepted",
            "running",
            "completed",
            "skipped_disabled",
            "interrupted"
          ]
        }
      },
      "required": [
        "format_version",
        "client_run_id",
        "request_id",
        "attempt_id",
        "state"
      ],
      "additionalProperties": false
    },
    "channel_health_response": {
      "type": "object",
      "properties": {
        "format_version": { "const": 1 },
        "gen": { "$ref": "common.schema.json#/definitions/decimal" },
        "channels": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "properties": {
              "pool_id": { "$ref": "common.schema.json#/definitions/id" },
              "channel_id": { "$ref": "common.schema.json#/definitions/id" },
              "credential_version": { "anyOf": [{ "$ref": "common.schema.json#/definitions/decimal" }, { "type": "null" }] },
              "state": { "enum": ["available", "exhausted", "auth_invalid"] },
              "state_version": { "$ref": "common.schema.json#/definitions/decimal" },
              "observed_at": { "anyOf": [{ "$ref": "common.schema.json#/definitions/utc" }, { "type": "null" }] }
            },
            "required": ["channel_id", "credential_version", "state", "state_version", "observed_at"],
            "additionalProperties": false
          }
        }
      },
      "required": ["format_version", "gen", "channels"],
      "additionalProperties": false
    },
    "health_reset_request": {
      "type": "object",
      "properties": {
        "format_version": { "const": 1 },
        "pool_id": { "$ref": "common.schema.json#/definitions/id" },
